    {"id": "points_before_capacity", "input": {"points": 2499, "count": 4}, "expect": "insufficient", "balance": 2499},
    {"id": "global_power_does_not_substitute", "input": {"zone_controlled": false, "global_power": true}, "expect": "unpowered", "balance": 2500},
