  "cases": [
    {"id": "one_point_short", "input": {"points": 2499}, "expect": "insufficient", "balance": 2499},
    {"id": "exact_price", "input": {}, "expect": "paid_pending", "balance": 0},
    {"id": "one_point_surplus", "input": {"points": 2501}, "expect": "paid_pending", "balance": 1},
    {"id": "capacity_equal", "input": {"count": 4}, "expect": "capacity", "balance": 2500},
    {"id": "capacity_below", "input": {"count": 3}, "expect": "paid_pending", "balance": 0},
    {"id": "active_duplicate", "input": {"active_owned": true}, "expect": "owned", "balance": 2500},
    {"id": "paused_duplicate", "input": {"paused_owned": true}, "expect": "owned", "balance": 2500},
    {"id": "busy_before_duplicate", "input": {"busy": true, "active_owned": true}, "expect": "busy", "balance": 2500},
