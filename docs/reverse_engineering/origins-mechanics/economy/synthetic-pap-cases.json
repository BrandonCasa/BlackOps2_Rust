{
  "purpose": "User-created serial abstract PaP episode; no native timing or atomic grant claim",
  "cases": [
    {"id": "price_minus_one", "points": 4999, "events": ["use"], "expect": {"points": 4999, "phase": "idle", "debits": 0, "original": true}},
    {"id": "exact_price_paid_pending", "points": 5000, "events": ["use"], "expect": {"points": 0, "phase": "processing", "in_use": true, "original": true, "upgraded": false}},
    {"id": "price_plus_one", "points": 5001, "events": ["use"], "expect": {"points": 1, "debits": 1}},
    {"id": "idle_power_loss", "points": 5000, "events": ["lose_power", "use"], "expect": {"points": 5000, "trigger": false, "debits": 0}},
    {"id": "return_before_ready", "points": 5000, "events": ["use", "remove", "take"], "expect": {"phase": "processing", "original": false, "upgraded": false, "grants": 0}},
    {"id": "nonowner_return", "points": 5000, "events": ["use", "remove", "ready", "other_take"], "expect": {"phase": "ready", "in_use": true, "grants": 0}},
    {"id": "invalid_return", "points": 5000, "events": ["use", "remove", "ready", "invalid_take"], "expect": {"phase": "ready", "in_use": true, "grants": 0}},
    {"id": "serial_duplicate_payment", "points": 10000, "events": ["use", "use", "remove", "ready", "use"], "expect": {"points": 5000, "debits": 1, "grants": 0}},
    {"id": "normal_return_once", "points": 5000, "events": ["use", "remove", "ready", "take", "cleanup", "grant", "take"], "expect": {"points": 0, "debits": 1, "grants": 1, "original": false, "upgraded": true, "in_use": false}},
    {"id": "before_ready_expiry", "points": 5000, "events": ["use", "remove", "ready", {"advance": 14}], "expect": {"phase": "ready", "in_use": true, "grants": 0}},
    {"id": "exact_ready_expiry", "points": 5000, "events": ["use", "remove", "ready", {"advance": 15}, "cleanup"], "expect": {"phase": "disposed", "points": 0, "original": false, "upgraded": false, "in_use": false}},
    {"id": "shutdown_after_taken_before_grant", "points": 5000, "events": ["use", "remove", "lose_power", "ready", "take", "cleanup"], "expect": {"phase": "grant_pending", "trigger": false, "in_use": false, "grants": 0, "upgraded": false}},
    {"id": "shutdown_then_grant_schedule", "points": 5000, "events": ["use", "remove", "lose_power", "ready", "take", "cleanup", "grant"], "expect": {"trigger": false, "upgraded": true, "grants": 1, "debits": 1}},
    {"id": "shutdown_after_timeout", "points": 5000, "events": ["use", "remove", "ready", "lose_power", {"advance": 15}, "cleanup"], "expect": {"trigger": false, "in_use": false, "points": 0, "upgraded": false}},
    {"id": "ready_disconnect_shutdown", "points": 5000, "events": ["use", "remove", "ready", "lose_power", "disconnect", "cleanup"], "expect": {"phase": "disposed", "trigger": false, "points": 0, "grants": 0}}
  ],
  "excluded": ["simultaneous pickup expiry tie", "native animation and scheduling", "pre-ready disconnect", "generic destructive power-off", "callback or level-intermission debit race", "at-capacity replacement", "ammo options", "sale or attachment price modes"]
}
