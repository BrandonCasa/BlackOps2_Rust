# Cargo and generated build products. Keep the application Cargo.lock when generated.
**/target/
/build/
/dist/
/release/
*.exe
*.dll
*.pdb
*.lib
*.obj
*.so
*.dylib
*.a
*.o

# Runtime closure and optional licensed source library are kept separately.
/assets/*
!/assets/origins/
/assets/origins/**
!/assets/origins/**/
!/assets/origins/game.json
!/assets/origins/texture-streaming.json
!/assets/origins/**/*.gltf
!/assets/origins/**/*.bin
!/assets/origins/**/*.png
!/assets/origins/**/*.dds
!/assets/origins/**/*.jpg
!/assets/origins/**/*.jpeg
!/assets/origins/**/*.dds
!/assets/origins/**/*.ogg
!/assets/origins/**/*.ttf
!/assets/origins/**/*.otf
**/original-assets/
**/local-assets/
**/local_assets/
**/proprietary/
**/vendor-assets/
**/extracted/
**/extractions/
**/dumps/
**/reports/
**/captures/
**/screenshots/
**/recordings/
*.ff
*.iwd
*.iwi
*.xpak
*.pak
*.bik
*.xmodel
*.xanim
*.gsc
*.csc
*.hlsl
*.fx
**/preparation.json

# Machine-specific configuration and credentials.
/config/local*.toml
!/config/local_assets.example.toml
.env
.env.*
**/secrets/
**/credentials/
*.pem
*.key
*.pfx
*.p12
*.keystore

# Local diagnostics, caches, and editor state.
*.log
*.profraw
*.profdata
*.tmp
*.bak
**/__pycache__/
.venv/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Optional preparation inputs are separate from runtime assets. Original
# installations and generated build products remain outside this allowance.
!/assets/source/
!/assets/source/**/
!/assets/source/**/*.ff
!/assets/source/**/*.iwd
!/assets/source/**/*.iwi
!/assets/source/**/*.xpak
!/assets/source/**/*.pak
!/assets/source/**/*.bik
!/assets/source/**/*.xmodel
!/assets/source/**/*.xanim
!/assets/source/**/*.bin
!/assets/source/**/*.dds
!/assets/source/**/*.wav
!/assets/source/**/*.zip
# The complete local-only source library includes native formats and exchanges.
!/assets/source/bo2/**
