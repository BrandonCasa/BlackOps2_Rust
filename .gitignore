# Cargo and generated build products. Keep the application Cargo.lock when generated.
**/target/
/build/
/dist/
/release/
*.exe
*.dll
*.pdb
*.lib
*.obj
*.so
*.dylib
*.a
*.o

# Licensed originals and raw inspection outputs belong outside the repository.
/assets/*
!/assets/origins/
/assets/origins/**
!/assets/origins/**/
!/assets/origins/game.json
!/assets/origins/**/*.gltf
!/assets/origins/**/*.bin
!/assets/origins/**/*.png
**/original-assets/
**/local-assets/
**/local_assets/
**/proprietary/
**/vendor-assets/
**/extracted/
**/extractions/
**/dumps/
**/reports/
**/captures/
**/screenshots/
**/recordings/
*.ff
*.iwd
*.iwi
*.xpak
*.pak
*.bik
*.xmodel
*.xanim
*.gsc
*.csc
*.hlsl
*.fx
**/preparation.json

# Machine-specific configuration and credentials.
/config/local*.toml
!/config/local_assets.example.toml
.env
.env.*
**/secrets/
**/credentials/
*.pem
*.key
*.pfx
*.p12
*.keystore

# Local diagnostics, caches, and editor state.
*.log
*.profraw
*.profdata
*.tmp
*.bak
**/__pycache__/
.venv/
.idea/
.vscode/
.DS_Store
Thumbs.db
