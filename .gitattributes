* text=auto eol=lf

# Prepared runtime assets only; configuration stays in ordinary Git.
# Optional source inputs never participate in the runtime dependency closure.
assets/source/bo2/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve source JSON bytes (including line endings), without LFS filtering.
assets/origins/game.json !filter !diff !merge -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
assets/origins/texture-streaming.json !filter !diff !merge -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
